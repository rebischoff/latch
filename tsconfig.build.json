{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@latch/contracts": ["packages/contracts/src/index.ts"],
      "@latch/policy": ["packages/policy/src/index.ts"],
      "@latch/dal": ["packages/dal/src/index.ts"],
      "@latch/adapter-better-auth": ["packages/adapter-better-auth/src/index.ts"],
      "@latch/adapter-neon": ["packages/adapter-neon/src/index.ts"],
      "@latch/adapter-pg-audit": ["packages/adapter-pg-audit/src/index.ts"],
      "@latch/audit": ["packages/audit/src/index.ts"],
      "@latch/pg-session": ["packages/pg-session/src/index.ts"],
      "@latch/approval": ["packages/approval/src/index.ts"],
      "@latch/react": ["packages/react/src/index.ts"],
      "@latch/codegen": ["packages/codegen/src/index.ts"],
      "@latch/app-kit": ["packages/app-kit/src/index.ts"],
      "@latch/adapter-pg-store": ["packages/adapter-pg-store/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "fixtures/crm-proof/**/*.ts"
  ],
  "exclude": ["**/node_modules/**"]
}
