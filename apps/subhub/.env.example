# Copy to .env.local and fill in before migrate / dev.

# Pooled connection — app runtime (Vercel preview/prod; use Neon "Pooled" string).
DATABASE_URL=postgresql://owner:PASSWORD@ep-....pooler.neon.tech/neondb?sslmode=require

# Direct connection — migrate + psql (Neon "Direct" string; omit to reuse DATABASE_URL).
DATABASE_URL_DIRECT=postgresql://owner:PASSWORD@ep-....neon.tech/neondb?sslmode=require

# latch_app role password (migration 006); required on Neon — e.g. openssl rand -base64 24
LATCH_APP_ROLE_PASSWORD=

# Better Auth (session/JWT-only — no Better Auth user table; roles from latch_user_roles)
AUTH_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3003

# First-run /setup install token (openssl rand -base64 24)
LATCH_SETUP_KEY=

# Dev stub (optional) — bypass Better Auth when latch_users row exists.
# Resolve: SELECT id FROM latch_users WHERE login_name = '<name>';
# LATCH_STUB_USER=
