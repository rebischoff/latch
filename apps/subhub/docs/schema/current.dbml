// SubHub schema view — design draft (see docs/schema/README.md for workflow).
// Task 17 complete (2026-06-16); job/site geography pass (2026-06-17).
// Procurement pass (2026-06-17): requisition layer, purchase_order_line_shipment splits, job-site inventory; billing split.
// Pre-migration pass (2026-06-17): purchase_order_* table names, SOV XOR, billable FK direction.
// Billing pass (2026-06-17): billable_line staging, SOV allocation, retainage/deposit invoice kinds.
// Planning pass (2026-06-27): site_area/site_asset + site_system; catalog system/specs/phase templates;
//   estimate_system tabs; scope_phase + progress_entry; drop job_work_item + estimate_section — see planning/09-migration-notes.md.
// Slices 1–6 at column level. Next: numbered migrations after DBML lock.
//
// Shipped baseline: migrations 001–016 (party interim shape). Target below.
// Task 18 batches: 018_party_refactor → 019_site → 020_site_contact_relation_dev_seed.
//
// **Editorial (diagram):** Do not rename TableGroups or change group [color] values.
// Do not edit current.dbdiagram for schema-only updates (layout canvas only).
//
// **016 → target delta:** drop `party.notes`; add `party_person`, `party_organization`,
// `note`; retarget `employee` → `party_person`; widen `party_role`; then Slice 2 tables.
// **Identity target (2026-06-18):** `party_person.latch_user_id` + profile chrome;
// `latch_users.login_email` (unique copy — app syncs from `party_email.is_login_email`).
// Drop `party_user` and `employee.latch_user_id`. Shipped SQL partially aligned — see decisions.

Project subhub {
  database_type: 'PostgreSQL'
  Note: '''
    **Latch platform** (`latch_*`) + **SubHub business** (Slices 1–6 design target).

    Migration order (task 18): party refactor → sites/addresses → optional dev seed.
    Slices 3–6 tables are design-only until their implementation tasks.

    SQL migrations remain canonical once shipped; refresh this file after each batch.
  '''
}

// ─── Platform (Latch) ───────────────────────────────────────────────────────

TableGroup latch_platform {
  latch_users
  latch_roles
  latch_user_roles
  latch_role_surfaces
  latch_role_grants
  latch_role_delegations
  latch_scopes
  latch_audit
  latch_pending_changes
  latch_app_config
  latch_policy_version
}

Table latch_users {
  id text [pk]
  login_name text [unique, not null, note: 'required after /setup or provision']
  login_email text [unique, note: 'nullable — app copies from designated party_email; Latch enforces UNIQUE']
  password_hash text [note: 'Better Auth; nullable']
  must_change_password boolean [not null, default: false, note: 'true when admin sets temp password on provision/reset; cleared after /change-password-required']
  created_at timestamptz [not null, default: `now()`]

  Note: '''
    Platform auth principal — credentials only (Better Auth). No FK to business tables.
    Session chrome (`display_name`, `avatar_url`, `nick_name`) on `party_person`. Person link
    via `party_person.latch_user_id` (nullable unique).

    `login_email` is a **copied** login alias — the business app chooses which `party_email`
    row is login (see `is_login_email`) and syncs `address` → `login_email` on provision
    and when the login email row is edited. Sign-in: `login_name` OR `login_email`
    (`resolveLatchUserId` — `latch_users` only).

    **Login email uniqueness:** `login_email` UNIQUE on this table is the platform guarantee;
    duplicate addresses may exist on `party_email` until one is promoted to login.

    Bootstrap `/setup` master may exist without `party_person` until linked.
    **Deferred:** `user_class` (`internal` | `external`) for portal row scope — decisions.md.
  '''
}

Table latch_roles {
  id uuid [pk, default: `gen_random_uuid()`]
  role_class text [not null, note: 'CHECK: system_data | system_iam | app']
  display_name text [not null]

  Note: 'Runtime role catalog. System rows identified by role_class (partial unique index).'
}

Table latch_user_roles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id text [not null]
  role_id uuid [not null]
  scope_id uuid [note: 'NULL = company-wide']

  indexes {
    (user_id, role_id, scope_id) [unique, name: 'latch_user_roles_assignment_unique']
  }

  Note: '''
    User ↔ role assignment (what they may do). Separate from `party_person.latch_user_id`
    (who they are in the business). PK changed from composite to surrogate id in 010.
  '''
}

Table latch_role_surfaces {
  role_id uuid [not null]
  surface_id text [not null]
  row_scope text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (role_id, surface_id) [pk]
  }
}

Table latch_role_grants {
  role_id uuid [not null]
  surface_id text [not null]
  field_id text [note: 'nullable = surface-level grant']
  action text [not null]
  mode text

  indexes {
    (role_id, surface_id, field_id, action) [unique]
  }
}

Table latch_role_delegations {
  role_id uuid [not null]
  assignable_role_id uuid [not null]

  indexes {
    (role_id, assignable_role_id) [pk]
  }
}

Table latch_scopes {
  id uuid [pk, default: `gen_random_uuid()`]
  kind text [not null]
  parent_id uuid [note: 'self-ref; nullable']
  display_name text [not null]
}

Table latch_audit {
  id bigint [pk, increment]
  occurred_at timestamptz [not null, default: `now()`]
  actor_id text [not null]
  action text [not null]
  module_id text
  entity_type text [not null]
  entity_id text [not null]
  field_ids text[]
  before jsonb
  after jsonb
  patch jsonb
  request_id text
  approval_id text

  Note: 'INSERT-only at DB role level. Immutable via trigger.'
}

Table latch_pending_changes {
  id uuid [pk]
  surface_id text [not null]
  entity_id text [not null]
  field_ids text[] [not null]
  patch jsonb [not null]
  status text [not null, note: 'CHECK: submitted | accepted | rejected | withdrawn']
  submitted_by text [not null]
  submitted_at timestamptz [not null]
  decided_by text
  decided_at timestamptz
  comment text
  batch_id uuid
  supersedes_id uuid

  Note: 'Verification queue (platform). SubHub v1 skips approval UX.'
}

Table latch_app_config {
  id smallint [pk, default: 1, note: 'CHECK id = 1 (single row)']
  audit_mode text [not null, default: 'full', note: 'CHECK: full | standard | recovery']
  setup_complete boolean [not null, default: false]
}

Table latch_policy_version {
  id smallint [pk, default: 1, note: 'CHECK id = 1 (single row)']
  version bigint [not null, default: 1]
}

// ─── Cross-cutting ───────────────────────────────────────────────────────────

TableGroup cross_cutting [color: #9b59b6] {
  note
}

Table note {
  id text [pk, default: `gen_random_uuid()::text`]
  entity_type text [not null, note: 'CHECK allowlist — see Note']
  entity_id text [not null]
  body text [not null, default: '']
  format text [not null, default: 'plain', note: 'plain | rich — when needed']
  sort_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id, sort_order) [name: 'note_entity_sort_idx']
  }

  Note: '''
    Polymorphic notes for any business anchor. Surfaces expose logical Field `notes`
    (v1 may aggregate to one editor; schema allows multiple rows per entity).

    Shipped 016: inline `party.notes` only. Task 18 backfill: non-empty `party.notes`
    → one `note` row per party (`entity_type = 'party'`), then drop the column.

    v1 entity_type allowlist (extend with migrations): party, site, site_area, site_asset,
    estimate, job, requested_order, purchase_order, material_receipt, invoice, change_order
    — align with `latch_audit.entity_type`.

    No FK on entity_id — polymorphic; enforce allowlist in migration/DAL.
  '''
}

// ─── Business (SubHub Slice 1) ──────────────────────────────────────────────

TableGroup party [color: #1abc9c] {
  party
  party_person
  party_organization
  party_role
  party_phone
  party_email
  party_contact_relation
  party_contact
  party_address
  employee
}

TableGroup postal [color: #95a5a6] {
  address
}

Table party {
  id text [pk, default: `gen_random_uuid()::text`]
  kind text [not null, note: 'CHECK: person | organization; immutable after create']
  display_name text [not null, note: 'list sort; DAL maintains from kind extension on save']
  legal_name text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    Unified contact anchor. Kind-specific columns live in 1:1 extension tables — not on `party`.
    `display_name` / `legal_name` — address-book and list sort. DAL maintains `display_name`
    from kind extension on save (person: first + last; org: legal_name or dba_name).
    Session shell label on `party_person.display_name` when linked. Notes → `note` table (no column here).
  '''
}

Table party_person {
  party_id text [pk]
  first_name text [not null]
  last_name text [not null, default: '']
  nick_name text [note: 'nullable — casual label']
  display_name text [note: 'nullable — session / nav override; fallback chain in DAL']
  avatar_url text [note: 'nullable — URL until polymorphic attachment lands']
  latch_user_id text [unique, note: 'nullable FK → latch_users — app login; persons only']

  Note: '''
    1:1 when party.kind = person. Structured name + optional session chrome. Staff HR on
    `employee` only. Login: opt-in via `latch_user_id` — any person (not only employees)
    may become an app user. Provision from person Surfaces ("add as db user"); IAM user
    Surface lists linked persons for role admin (no create/delete there).

    **Name layers:** `first_name` / `last_name` (structured); `party.display_name` (list sort,
    DAL-maintained); `nick_name` / `display_name` (session chrome when logged in).

    Task 18 backfill from 016: `first_name` ← `party.display_name`, `last_name` ← ''.
    Split heuristic (e.g. on space) is optional post-migration cleanup — not required in DDL.
  '''
}

Table party_organization {
  party_id text [pk]
  parent_party_id text [note: 'nullable FK → party.id — org subsidiary; persons forbidden; DAL anti-cycle']
  dba_name text [note: 'doing-business-as; nullable when same as legal_name']

  indexes {
    parent_party_id [name: 'party_organization_parent_party_id_idx']
  }

  Note: '''
    1:1 when party.kind = organization. Enforce kind match in migration (trigger or app txn).
    `parent_party_id` — corporate tree for customer/vendor hub (Model A: each node is its own
    tagged party). See party.md 2026-06-18 subsidiaries decision.

    Task 18 backfill: insert row for every organization party; set `dba_name` when
    `display_name` ≠ `legal_name`, else leave null. `parent_party_id` null for existing rows.
  '''
}

Table party_role {
  party_id text [not null]
  role text [not null, note: 'CHECK: customer | vendor | manufacturer | employee | property_owner | other']

  indexes {
    (party_id, role) [pk]
  }

  Note: '''
    Master address-book tags (who is this party to us generally?). Drives filtered list
    Surfaces (`customer_list`, `employee_list`, …). Not job context — job stakeholders use
    `job_party` (Slice 5). `employee` tag marks staff; app login via `party_person.latch_user_id`.
    `property_owner` / `other` widened in `018_party_refactor.sql`. GC / sub roles stay
    on `job_party`, not here.
  '''
}

Table party_phone {
  id text [pk, default: `gen_random_uuid()::text`]
  party_id text [not null]
  label text [not null, default: '']
  number text [not null]
  is_primary boolean [not null, default: false]
  sort_order int [not null, default: 0]

  Note: '''
    Child collection on `party` (person or org). Logical Field `phones` on contact Surfaces.
    `is_primary` + `sort_order` drive list display; at most one primary per party (app/DAL).
  '''
}

Table party_email {
  id text [pk, default: `gen_random_uuid()::text`]
  party_id text [not null]
  label text [not null, default: '']
  address text [not null]
  is_primary boolean [not null, default: false]
  is_login_email boolean [not null, default: false, note: 'at most one true per party when linked to latch_users']
  sort_order int [not null, default: 0]

  Note: '''
    Child collection on `party`. Multiple rows per party; **`address` is not globally UNIQUE**
    (same address may appear on different parties as contact data).

    **Login email (app-owned):** mark one row `is_login_email` when the person has
    `party_person.latch_user_id`; app DAL copies `address` → `latch_users.login_email`
    (platform UNIQUE). On patch to the login row, sync `login_email` in the same transaction.
    Before setting `is_login_email` or copying, app checks `login_email` uniqueness (DB
    constraint is authoritative).

  v1: one login email per linked person. `is_primary` and `is_login_email` are independent.
  '''
}

Table party_contact_relation {
  id text [pk, default: `gen_random_uuid()::text`]
  display_name text [not null]
  sort_order int [not null, default: 0]

  indexes {
    display_name [unique, name: 'party_contact_relation_display_name_unique']
  }

  Note: '''
    Catalog of org-level contact roles (AP, billing, superintendent, …). Progressive setup +
    `party_contact_relation_table` catalog page. Distinct from `site_contact_relation` (property).
  '''
}

Table party_contact {
  id text [pk, default: `gen_random_uuid()::text`]
  organization_party_id text [not null, note: 'FK → party (organization)']
  contact_party_id text [not null, note: 'FK → party (person)']
  relation_id text [not null, note: 'FK → party_contact_relation']
  title text [not null, default: '']
  sort_order int [not null, default: 0]

  indexes {
    (organization_party_id, contact_party_id, relation_id) [unique, name: 'party_contact_org_person_relation_unique']
  }

  Note: '''
    Org-level contacts — person parties linked to an organization lens. Logical Field `contacts`
    on `customer_detail` / `vendor_detail` (org only). Quick-create person + attach via
    `add_contact` action. Same person may also appear on `site_contact`.
  '''
}

Table employee {
  party_id text [pk]

  Note: '''
    Staff-only HR/ops extension. FK → party_person (not bare `party`); requires
    `party.kind = person` and `party_role` tag `employee`. Not all persons are employees;
    not all employees have login (`party_person.latch_user_id` null until provisioned).

    Login provision: "add as db user" on `employee_detail` (or any person lens) — not on
    IAM user Surface. Termination: HR marks employee; IAM suspends roles — do not delete
    `latch_users` when payroll/history access may still be needed.

    Deferred columns (document only — do not add to DDL yet):
    hire_date, termination_date, employee_number, job_title, department,
    reports_to → employee, employment_status, primary_site_id.
    Name / phones / emails stay on party spine; permissions on latch_user_roles.
  '''
}

Table party_address {
  party_id text [not null]
  address_id text [not null]
  purpose text [not null, note: 'CHECK: billing | remit_to | hq | mailing | other']

  indexes {
    (party_id, address_id, purpose) [pk]
  }

  Note: '''
    Party ↔ postal address junction (`019_site.sql`). Purpose = billing, HQ, mailing, …
    In-building geography lives on `site_area` / `site_asset` (site-owned) — not here.
  '''
}

// ─── Business (SubHub Slice 2) ──────────────────────────────────────────────

TableGroup site [color: #3498db] {
  site
  site_scope
  site_zone
  site_asset
  site_contact_relation
  site_contact
}

Table address {
  id text [pk, default: `gen_random_uuid()::text`]
  label text [not null, default: '', note: 'optional suite/floor on postal row — not in-building spot']
  line1 text [not null, default: '']
  line2 text [not null, default: '']
  city text [not null, default: '']
  state text [not null, default: '']
  postal_code text [not null, default: '']
  country text [not null, default: 'US']
  lat numeric [note: 'nullable — optional manual pin']
  lng numeric [note: 'nullable — optional manual pin']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    Normalized **postal** address — shared spine (`TableGroup postal`). Manual entry in v1;
    verification deferred. Attached via `party_address` and optional `site.physical_address_id`.
    Do **not** merge with `party_address`. In-building geography = `site_area` / `site_asset` on a
    `site` — see planning/01-site-as-built.md.
  '''
}

Table site {
  id text [pk, default: `gen_random_uuid()::text`]
  name text [not null]
  customer_party_id text [note: 'nullable FK → party — portfolio customer for customer hub tree (not vendor hub)']
  parent_site_id text [note: 'nullable FK → site.id; ON DELETE SET NULL']
  physical_address_id text [note: 'nullable FK → address — dispatch/maps; wave 2b; many sites may share one row']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    customer_party_id [name: 'site_customer_party_id_idx']
    parent_site_id [name: 'site_parent_site_id_idx']
    physical_address_id [name: 'site_physical_address_id_idx']
  }

  Note: '''
    Logical place — portfolio, campus, building, job site. **No inline postal columns** on `site`.
    Optional **`physical_address_id`** → `address` for dispatch/maps (wave 2b). Billing postal on
    party via `party_address`. **Site-owned as-built geography**:
    optional `site_scope` → `site_zone` (tree) → `site_asset` (device leaf); estimates may add `proposed` rows.

    **`customer_party_id`** — which customer org owns this property in the address-book
    hub (subsidiary or top-level). Set when creating site from **customer_detail** only.
    Vendor hub does not create sites.

    **Property owner** — recorded via **`site_contact`** + site relation label (e.g. Property owner),
    not a portfolio FK on `site`.

    Per-job counterparties remain on `job_party`. See site.md 2026-06-18.

    Worked example (Tower REIT / 200 Market Tower):
      party "Tower REIT" + party_address → address "200 Market St" (purpose: hq)
      site "200 Market Tower" — site_scope "Fire alarm" → site_zone "Floor 3" → site_asset "Pull station PS-12"
      estimate @ site → may create proposed site_zone/site_asset; lines reference site_zone_id
      job complete → promotes proposed → active; publishes relocations/removals

    Hierarchy (optional): parent_site_id — Portfolio → Building → Wing.
    Standing people: `site_contact`. Per-job counterparties: `job_party` (Slice 5).
    Notes: polymorphic `note` (`entity_type = 'site'`).
  '''
}

Table site_scope {
  id text [pk, default: `gen_random_uuid()::text`]
  site_id text [not null]
  root_item_id text [not null, note: 'FK → item (parent_id IS NULL) — Fire alarm, CCTV, …']
  name text [not null, default: '']
  status text [not null, default: 'proposed', note: 'CHECK: proposed | active | removed | cancelled']
  sort_order int [not null, default: 0]

  Note: '''
    Optional installed **scope root** instance on a site (renamed from `site_system`). Multiple
    instances per root category OK (Panel A / Panel B). Zones/assets may attach to a scope or
    default no-scope bucket (`site_scope_id` null). Child collection on `site_detail` (`scopes`).
  '''
}

Table site_zone {
  id text [pk, default: `gen_random_uuid()::text`]
  site_id text [not null]
  site_scope_id text [note: 'nullable FK → site_scope — null = site General bucket']
  parent_zone_id text [note: 'nullable FK → site_zone — tree within same scope/bucket']
  name text [not null, default: '']
  sort_order int [not null, default: 0]
  status text [not null, default: 'proposed', note: 'CHECK: proposed | active | removed | cancelled']

  Note: '''
    Nested zones per scope (or General bucket). Renamed from `site_area`. Site-owned as-built;
    tombstone via `status`. UI label: **zone**.
  '''
}

Table site_asset {
  id text [pk, default: `gen_random_uuid()::text`]
  site_id text [not null]
  site_scope_id text [note: 'nullable FK → site_scope']
  site_zone_id text [note: 'nullable FK → site_zone — placement parent']
  asset_type text [not null, default: '', note: 'device kind — camera, reader, pull_station, …']
  tag_label text [not null, default: '', note: 'field label — Rm 345 Cam 1, Door 101 reader']
  part_id text [note: 'nullable FK → manufacturer_part']
  manufacturer text [not null, default: '']
  model text [not null, default: '']
  serial_number text [not null, default: '']
  sort_order int [not null, default: 0]
  status text [not null, default: 'planned', note: 'CHECK: planned | installed | active | removed | replaced']
  replaced_by_site_asset_id text [note: 'nullable FK → site_asset — relocate/replace target']
  serviceable boolean [not null, default: true]
  installed_by_job_id text [note: 'nullable FK → job — provenance']

  Note: '''
    Installed **serviceable device** — leaf only (no `parent_asset_id` v1). Door = **area**
    (`door_group`); reader/strike/REX/contact = **assets**. **Site-owned** as-built registry.
    Child collection on `site_detail` (`assets`). `replaced_by_site_asset_id` = fast “where is it
    now?” query; full history → `latch_audit`. Field progress does **not** update this table —
    only `job.complete` publishes `proposed` → `active`.
  '''
}

Table site_contact_relation {
  id text [pk, default: `gen_random_uuid()::text`]
  display_name text [not null]
  sort_order int [not null, default: 0]

  indexes {
    display_name [unique, name: 'site_contact_relation_display_name_unique']
  }

  Note: '''
    Catalog of standing-contact roles at a property (Slice 2). `019_site.sql` creates
    empty table (task 16). Suggested rows for progressive setup / dev seed (`020`): Property
    owner, Property manager, Site superintendent, Other — Postgres-assigned ids only.

    Billing contact is on the customer (`party_address` billing or `job_party` bill_to) —
    not a site standing role. Not a substitute for `job_party` job-scoped relations.
  '''
}

Table site_contact {
  id text [pk, default: `gen_random_uuid()::text`]
  site_id text [not null]
  party_id text [not null]
  relation_id text [not null, note: 'FK → site_contact_relation']
  sort_order int [not null, default: 0]

  indexes {
    (site_id, party_id, relation_id) [unique, name: 'site_contact_site_party_relation_unique']
  }

  Note: '''
    Standing people/orgs at a site. Child collection on `site_detail`. Links existing `party`
    rows — create contacts first, then attach. Unique per (site, party, relation) unless
    product later needs duplicates.
  '''
}

// ─── Business (SubHub Slice 3 — catalog) ─────────────────────────────────────

TableGroup catalog [color: #e67e22] {
  trade
  spec_unit
  spec_def
  spec_option
  item_spec_participation
  manufacturer_part_spec
  labor_phase
  item_labor_phase
  item
  part_item
  labor_rate_type
  cost_add_on_type
  markup_type
  complexity_factor
  phase
  manufacturer_part
  vendor_part
  item_part_link
}

Table trade {
  id text [pk, default: `gen_random_uuid()::text`]
  name text [not null, note: 'e.g. electrical, low voltage, fire alarm contractor']
  sort_order int [not null, default: 0]

  Note: 'Who performs work — used on `job_scope_group` for production rollups and labor costing.'
}

Table spec_unit {
  id uuid [pk, default: `gen_random_uuid()`]
  symbol text [not null]
  name text [not null]
  dimension text [not null]
  canonical_unit_id uuid [note: 'null = this row is canonical for dimension']
  to_canonical_factor numeric [not null, default: 1]
  sort_order int [not null, default: 0]

  Note: '''
    Org unit catalog for numeric spec defs (37p, 2026-07-08). Conversion factors normalize to
    canonical per dimension; `spec_def.unit_id` may reference a non-canonical row (e.g. mA).
    Admin Surface `spec_unit_table` in 37q.
  '''
}

Table spec_def {
  id uuid [pk, default: `gen_random_uuid()`]
  scope_root_item_id text [not null, note: 'FK → item where node_type = scope — flat namespace, no ownership/inheritance (37o)']
  display_name text [not null]
  value_type text [not null, default: 'enum', note: 'CHECK: enum | boolean | number (37s)']
  unit_id uuid [note: 'nullable FK → spec_unit — required in DAL for number']
  decimal_places int [note: 'nullable — display-only formatting (37p)']
  sort_order int [not null, default: 0]

  Note: '''
    **37o (2026-07-07):** flat namespace per scope root — `scope_root_item_id` replaces the prior
    owning-node `item_id` (no node in the tree "owns" a def; no inheritance). Edited on
    `item_detail` `spec_definitions` Field (scope tab only, 37o UI pivot 2026-07-08).
    Renamed from `system_spec_def` (028) → node-owned (038/040a) → scope-scoped (37o).
    Estimate and part rows FK to `spec_option` for enums — not loose strings.
    `code` column dropped (048) — matching uses FK ids only.
    **37p (2026-07-08):** `text` dropped; `number` + `unit_id`/`decimal_places` added.
    **37s (2026-07-08):** `range` def type dropped — band via optional part `value_number_max`.
  '''
}

Table spec_option {
  id uuid [pk, default: `gen_random_uuid()`]
  spec_def_id uuid [not null]
  display_name text [not null]
  sort_order int [not null, default: 0]

  Note: 'Enum values for a `spec_def`. Renamed from `system_spec_option`. `code` dropped (048).'
}

Table manufacturer_part_spec {
  manufacturer_part_id text [not null]
  spec_def_id uuid [not null]
  spec_option_id uuid [note: 'nullable — enum match; multiple rows per def allowed']
  value_boolean boolean [note: 'nullable — boolean defs']
  value_number numeric [note: 'nullable — number/range defs (canonical unit, 37p)']
  value_number_max numeric [note: 'nullable — range defs only (canonical unit, 37p)']

  indexes {
    (manufacturer_part_id, spec_def_id, spec_option_id) [unique, name: 'manufacturer_part_spec_unique']
  }

  Note: '''
    Part compatibility rows — filter/suggest in estimate part picker. `manufacturer_part.specs` text
    column is human notes only; never used for filtering. Numeric values stored in canonical unit
    (37p); `value_text` dropped when empty at migration 049.
  '''
}

Table labor_phase {
  id text [pk, default: `gen_random_uuid()::text`]
  name text [not null, unique]
  sort_order int [not null, default: 0]

  Note: 'Org labor phase catalog — referenced by `item_labor_phase` for commercial costing (040b).'
}

Table item_labor_phase {
  item_id text [not null]
  labor_phase_id text [not null]
  labor_rate_type_id text [not null]
  hours_per_unit numeric [not null, default: 0]
  sort_order int [not null, default: 0]

  indexes {
    (item_id, labor_phase_id) [pk]
  }

  Note: 'Labor hours × rate per item node — one row per phase per item (040b).'
}

Table item {
  id text [pk, default: `gen_random_uuid()::text`]
  name text [not null]
  parent_id text [note: 'nullable FK → item.id; NULL = scope root (Fire Alarm, HVAC, …)']
  node_type text [not null, default: 'category', note: 'CHECK: scope | category | item — structural role (044)']
  csi_code text [note: 'nullable — when aligned to CSI MasterFormat']
  sort_order int [not null, default: 0]
  description text [not null, default: '']
  default_part_id text [note: 'nullable FK → manufacturer_part']
  default_vendor_part_id text [note: 'nullable FK → vendor_part']
  fallback_unit_cost numeric [not null, default: 0]
  freight_rate_type_id text [note: 'nullable FK → cost_add_on_type (kind=freight)']
  incidental_rate_type_id text [note: 'nullable FK → cost_add_on_type (kind=incidental)']
  markup_type_id text [note: 'nullable FK → markup_type']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    **Unified item tree** (040a) — merges legacy `category` + `item`. Scope roots have
    `parent_id IS NULL` and `node_type = scope`. Estimate lines anchor to **quotable leaves**
    only (`node_type = item`, 044). Commercial FKs + `item_labor_phase` resolved via
    `resolveRate(N, R)` (040b).
  '''
}

Table item_spec_participation {
  item_id text [not null, note: 'FK → item where node_type = item — leaf only (37o)']
  spec_def_id uuid [not null]
  sort_order int [not null, default: 0]

  indexes {
    (item_id, spec_def_id) [pk]
  }

  Note: '''
    **37o (2026-07-07):** flat per-leaf opt-in — replaces `item_spec_exclude` +
    ownership-based inheritance. No ancestry, no exclude semantics: a row's presence means
    this item's part filter uses this dimension; absence means it doesn't. Editing one item's
    rows never affects any other item.
  '''
}

Table part_item {
  part_id text [not null]
  item_id text [not null]
  sort_order int [not null, default: 0]

  indexes {
    (part_id, item_id) [pk]
  }
}

Table labor_rate_type {
  id text [pk, default: `gen_random_uuid()::text`]
  name text [not null, unique]
  rate_cents int [not null, default: 0]
  sort_order int [not null, default: 0]

  Note: 'Labor class + hourly rate in one row (040b).'
}

Table cost_add_on_type {
  id text [pk, default: `gen_random_uuid()::text`]
  kind text [not null, note: 'CHECK: freight | incidental']
  name text [not null]
  percent numeric [not null, default: 0, note: '% of unit_material']
  amount_cents int [not null, default: 0, note: 'fixed per quoted unit']
  sort_order int [not null, default: 0]

  indexes {
    (kind, name) [unique]
  }

  Note: 'Freight + incidental add-on profiles — split surfaces filter by `kind` (040b).'
}

Table markup_type {
  id text [pk, default: `gen_random_uuid()::text`]
  name text [not null, unique]
  material_markup_percent numeric [not null, default: 0]
  labor_markup_percent numeric [not null, default: 0]
  sort_order int [not null, default: 0]

  Note: 'Split markup — material side on M+freight+incidental; labor side on unit_labor (040b).'
}

Table complexity_factor {
  id text [pk, default: `gen_random_uuid()::text`]
  name text [not null, unique]
  factor_percent numeric [not null, default: 100]
  sort_order int [not null, default: 0]

  Note: 'Labor complexity multiplier — assigned on estimate scope/zone only (040b).'
}

Table phase {
  id text [pk, default: `gen_random_uuid()::text`]
  name text [not null, note: 'e.g. prewire, installation, programming, testing']
  sort_order int [not null, default: 0]

  Note: '''
    **Retired (045).** Replaced by org `labor_phase` + `item_labor_phase` for costing and
    `scope_phase.labor_phase_id` for progress. Table dropped in migration 045.
  '''
}

Table manufacturer_part {
  id text [pk, default: `gen_random_uuid()::text`]
  manufacturer_party_id text [not null, note: 'FK → party (manufacturer tag)']
  mpn text [not null, note: 'manufacturer part number']
  description text [not null, default: '']
  specs text [not null, default: '']
  unit text [not null, default: 'ea', note: 'estimate/engineering UOM — ft, ea, hr, …']
  purchase_unit text [note: 'nullable — when bought differently (e.g. spool); defaults to unit']
  units_per_purchase numeric [not null, default: 1, note: 'e.g. 1000 when unit=ft, purchase_unit=spool']
  cut_sheet_url text [note: 'nullable — URL until polymorphic attachment lands']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (manufacturer_party_id, mpn) [unique, name: 'manufacturer_part_mpn_unique']
  }

  Note: '''
    Exact manufacturer part (MPN). **UOM lives here only** — vendor prices inherit this unit
    context (quote 300 ft; PO 1 spool via purchase_unit + units_per_purchase). PO / job
    engineering use exact parts; estimates often use generic `item` until win.
  '''
}

Table vendor_part {
  id text [pk, default: `gen_random_uuid()::text`]
  vendor_party_id text [not null, note: 'FK → party (vendor tag)']
  manufacturer_part_id text [not null, note: 'FK → manufacturer_part']
  vendor_pn text [not null, note: 'vendor catalog / stock number']
  vendor_description text [not null, default: '']
  unit_price numeric [not null, note: 'per manufacturer_part.purchase_unit when set, else per unit']
  currency text [not null, default: 'USD']
  lead_time_days int [note: 'nullable — vendor lead time; order_by = scope_phase.target_date − lead_time (P2)']
  is_preferred boolean [not null, default: false]

  indexes {
    (vendor_party_id, vendor_pn) [unique, name: 'vendor_part_vendor_pn_unique']
  }

  Note: '''
    Vendor orderable SKU + current price (v1 one row per vendor PN; history deferred). No UOM
    column — inherits from `manufacturer_part`. Snapshot onto lines at pick time.
  '''
}

Table item_part_link {
  item_id text [not null]
  part_id text [not null]
  link_role text [not null, default: 'alternate', note: 'CHECK: alternate | component']
  quantity numeric [not null, default: 1]
  sort_order int [not null, default: 0]

  indexes {
    (item_id, part_id) [pk]
  }

  Note: '''
    Links item → `manufacturer_part`. `alternate` = approved substitute (one-of-many). `component`
    = required BOM row when `item.kind = assembly`. Only link table for item composition.
    Child collection on `item_detail`.
  '''
}

// ─── Business (SubHub Slice 4 — estimates) ───────────────────────────────────

TableGroup estimate [color: #f39c12] {
  job_party_relation
  estimate
  estimate_party
  estimate_condition
  estimate_condition_spec
  estimate_condition_labor_phase
  estimate_line_spec
  estimate_line
  estimate_line_allocation
}

Table job_party_relation {
  id text [pk, default: `gen_random_uuid()::text`]
  display_name text [not null]
  sort_order int [not null, default: 0]

  indexes {
    display_name [unique, name: 'job_party_relation_display_name_unique']
  }

  Note: '''
    Catalog of engagement-scoped stakeholder roles (estimate + job). Parallel to
    `site_contact_relation`. Suggested defaults: Customer, Property owner, Bill to, Sold to,
    General contractor, Subcontractor, Subcontract through — empty at first migration in
    Slice 4/5; progressive setup + catalog table page (decisions.md 2026-06-15).
    Not master `party_role` tags (GC/sub live here).
  '''
}

Table estimate {
  id text [pk, default: `gen_random_uuid()::text`]
  site_id text [not null, note: 'FK → site — logical place for quote']
  title text [not null, default: '']
  status text [not null, default: 'draft', note: 'CHECK: draft | sent | won | lost | expired']
  estimate_date date [note: 'nullable — quote date']
  valid_until date [note: 'nullable — quote expiry']
  source_estimate_id text [note: 'nullable FK → estimate.id; revision chain']
  item_id text [note: 'nullable FK → item — optional default grouping context for quote']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    Sales quote anchor. Stakeholders on `estimate_party`. Quote structure uses **`estimate_system`**
    tabs (one per building system) with per-tab spec knobs and area/asset rollups — not
    `estimate_section` in v1. Won quote → `job` copies site, parties, system blocks, and line snapshots.
  '''
}

Table estimate_party {
  estimate_id text [not null]
  party_id text [not null]
  relation_id text [not null, note: 'FK → job_party_relation']
  sort_order int [not null, default: 0]

  indexes {
    (estimate_id, party_id, relation_id) [pk]
  }

  Note: 'Per-quote stakeholder graph. Copied to `job_party` when estimate is won.'
}

Table estimate_condition {
  id text [pk, default: `gen_random_uuid()::text`]
  estimate_id text [not null, note: 'FK → estimate — forest owner (37y Y1)']
  parent_condition_id text [note: 'nullable FK → estimate_condition — null = root']
  root_item_id text [note: 'FK → item (parent_id IS NULL); NOT NULL on roots; null on children (inherit tree root)']
  name text [not null]
  complexity_factor_id text [note: 'nullable FK → complexity_factor — null = inherit ancestry / 100% at root']
  labor_phases_explicit boolean [not null, default: false, note: 'Y4 sentinel: true = own phase set (junction may be empty = no phases); false = inherit']
  sort_order int [not null, default: 0]

  Note: '''
    Estimate-owned commercial node (37y). Forest of trees under an estimate. Roots carry
    `root_item_id` (catalog root). Children nest via `parent_condition_id`. Every node holds
    name, complexity, labor phases, and specs. Cascade: line → leaf → … → root → catalog.
  '''
}

Table estimate_condition_spec {
  id text [pk, default: `gen_random_uuid()::text`]
  estimate_condition_id text [not null]
  spec_def_id uuid [not null]
  spec_option_id uuid [note: 'nullable — enum defs']
  value_boolean boolean [note: 'nullable — boolean defs']
  value_number numeric [note: 'nullable — number/range bucket point (canonical, 37p)']
  value_number_max numeric [note: 'nullable — unused on buckets']

  Note: 'Per-condition spec. Resolution: line → condition leaf→root → catalog (37y Y3).'
}

Table estimate_condition_labor_phase {
  estimate_condition_id text [not null]
  labor_phase_id text [not null]
  sort_order int [not null, default: 0]

  indexes {
    (estimate_condition_id, labor_phase_id) [pk]
  }

  Note: 'Own labor phases when `labor_phases_explicit` — empty junction = explicit no phases (Y4).'
}

Table estimate_line_spec {
  id text [pk, default: `gen_random_uuid()::text`]
  estimate_line_id text [not null]
  spec_def_id uuid [not null]
  spec_option_id uuid [note: 'nullable — enum defs']
  value_boolean boolean [note: 'nullable — boolean defs']
  value_number numeric [note: 'nullable — number/range bucket point (canonical, 37p)']
  value_number_max numeric [note: 'nullable — unused on buckets']

  Note: 'Per-line spec override. Resolution: line → condition leaf→root → catalog (37y Y3).'
}

Table estimate_line {
  id text [pk, default: `gen_random_uuid()::text`]
  estimate_id text [not null]
  estimate_condition_id text [not null, note: 'FK → estimate_condition — required (37y Y2)']
  parent_line_id text [note: 'nullable FK → estimate_line — kit header/component']
  line_number int [not null]
  line_role text [not null, default: 'standalone', note: 'CHECK: standalone | kit_header | kit_component']
  description text [not null, default: '']
  quantity numeric [not null, default: 1]
  qty_manual boolean [not null, default: false, note: 'false = allocations drive quantity (37x X3)']
  unit text [not null, default: 'ea', note: 'snapshotted UOM — from manufacturer_part.unit or labor/expense default']
  unit_cost numeric [not null, default: 0]
  unit_price numeric [not null, default: 0]
  unit_price_target numeric [note: 'nullable — policy sell from markup at calc']
  unit_material numeric [not null, default: 0]
  unit_labor numeric [not null, default: 0]
  unit_freight numeric [not null, default: 0]
  unit_incidental numeric [not null, default: 0]
  site_asset_id text [note: 'nullable FK → site_asset — device-level scope']
  lock text [not null, default: 'none', note: 'CHECK: none | sell | line — recalc gate (040b D6b)']
  item_id text [not null, note: 'FK → item — required on product lines']
  part_id text [note: 'nullable FK → manufacturer_part — when PN determined or user-picked']
  vendor_part_id text [note: 'nullable FK → vendor_part — cost source when pinned']
  sort_order int [not null, default: 0]

  indexes {
    (estimate_id, line_number) [unique, name: 'estimate_line_number_unique']
  }

  Note: '''
    Quote line — **item_id** at any tree depth; commercial snapshots M/L/freight/incidental/target.
    Places via `estimate_line_allocation` (not a single site_zone_id). **lock** — none/sell/line (040b).
  '''
}

Table estimate_line_allocation {
  id text [pk, default: `gen_random_uuid()::text`]
  estimate_line_id text [not null]
  site_zone_id text [not null]
  quantity numeric [not null, default: 1]

  indexes {
    (estimate_line_id, site_zone_id) [unique]
  }

  Note: 'Optional place rows: site zone × qty-per-zone. sum(qty) ≤ line.quantity when qty_manual (G3).'
}

// ─── Business (SubHub Slice 5 — jobs) ─────────────────────────────────────────

TableGroup job [color: #e74c3c] {
  job
  job_party
  job_scope_group
  job_line
  job_line_part
  scope_phase
  progress_entry
  progress_entry_line
  job_system_spec
  job_area_spec
  job_line_spec
  change_order
  change_order_line
}

Table job {
  id text [pk, default: `gen_random_uuid()::text`]
  site_id text [not null, note: 'FK → site — where work happens']
  estimate_id text [note: 'nullable FK → estimate — source won quote']
  parent_job_id text [note: 'nullable FK → job — warranty / follow-up to prior job']
  job_kind text [not null, default: 'project', note: 'CHECK: project | service | warranty']
  billing_model text [not null, default: 'progress_line', note: 'CHECK: lump_sum | progress_line | progress_sov | tm']
  billing_basis text [not null, default: 'qty_installed', note: 'CHECK: qty_installed | qty_received | manual — default auto billable generator']
  bill_on_work_status text [not null, default: 'installed', note: 'CHECK: installed | verified — work_item threshold for auto billable from field status']
  retainage_pct numeric [not null, default: 0, note: 'contract retainage % withheld on progress invoices — e.g. 10']
  title text [not null, default: '']
  status text [not null, default: 'planned', note: 'CHECK: planned | active | complete | cancelled']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    Operations anchor — install projects, service calls, and warranty work share one model
    (`job_kind`). No sole customer_id — graph on `job_party`. Site geography on `site_area` /
    `site_asset`; lines FK `site_area_id` / `site_asset_id`. On `complete`, DAL publishes
    proposed → active and applies relocations/removals to site registry (does not rewrite closed
    job line FKs).

    **Scope model:** `job_scope_group` → `job_line` → `scope_phase` → `progress_entry` /
    `progress_entry_line` (replaces `job_work_item` — J1 locked).

    **Billing:** `billing_model` selects lump-sum at complete, line progress, SOV milestones, or
    T&M. `billing_basis` drives auto `billable_line` generation (deferred v1 — manual staging first).
    Customer invoices always snapshot on `invoice` / `invoice_line` — see billing TableGroup.
  '''
}

Table job_party {
  job_id text [not null]
  party_id text [not null]
  relation_id text [not null, note: 'FK → job_party_relation']
  sort_order int [not null, default: 0]

  indexes {
    (job_id, party_id, relation_id) [pk]
  }

  Note: 'Per-job stakeholders. Relations from `job_party_relation` catalog — not master `party_role`.'
}

Table job_scope_group {
  id text [pk, default: `gen_random_uuid()::text`]
  job_id text [not null]
  name text [not null, default: '']
  group_type text [not null, default: 'general', note: 'CHECK: location | trade | system | phase | sov_section | change_order | repair_group | testing_group | closeout_group | general']
  trade_id text [note: 'nullable FK → trade']
  root_item_id text [note: 'nullable FK → item (scope root)']
  fulfillment_type text [note: 'nullable — self | subcontracted | by_others | allowance | …']
  site_scope_id text [note: 'nullable FK → site_scope']
  site_zone_id text [note: 'nullable FK → site_zone']
  sov_line_id text [note: 'nullable FK → sov_line — optional default SOV link']
  sort_order int [not null, default: 0]

  Note: '''
    Production organizer on the job — **not** a work order, **not** a `site_area`. Win from
    `estimate_system` tabs may create groups; flat jobs use null `job_line.job_scope_group_id` →
    synthetic **General** in UI (J4). Child collection on `job_detail` Scope tab.
  '''
}

Table job_line {
  id text [pk, default: `gen_random_uuid()::text`]
  job_id text [not null]
  job_scope_group_id text [note: 'nullable FK → job_scope_group — null = implicit General (J4)']
  line_number int [not null]
  line_role text [not null, default: 'standalone', note: 'CHECK: standalone | kit_header | kit_component']
  line_kind text [not null, default: 'product', note: 'CHECK: product | labor | expense']
  description text [not null, default: '']
  quantity numeric [not null, default: 1]
  unit text [not null, default: 'ea']
  unit_cost numeric [not null, default: 0]
  unit_price numeric [not null, default: 0]
  site_zone_id text [note: 'nullable FK → site_zone — frozen for this job line']
  site_asset_id text [note: 'nullable FK → site_asset — device-level scope']
  material_status text [note: 'nullable — carried from estimate']
  item_id text [note: 'nullable FK → item — sold scope; may stay generic']
  part_id text [note: 'nullable FK → manufacturer_part']
  vendor_part_id text [note: 'nullable FK → vendor_part']
  estimate_line_id text [note: 'nullable FK → estimate_line']
  change_order_line_id text [note: 'nullable FK → change_order_line — provenance']
  parent_line_id text [note: 'nullable FK → job_line']
  source text [not null, default: 'manual', note: 'CHECK: estimate | change_order | manual']
  status text [not null, default: 'active', note: 'CHECK: active | voided | superseded']
  superseded_by_job_line_id text [note: 'nullable FK → job_line — revise chain']
  sort_order int [not null, default: 0]

  indexes {
    (job_id, line_number) [unique, name: 'job_line_number_unique']
  }

  Note: '''
    Sold / contract scope — unified ledger from estimate win, change orders, or manual entry.
    Engineering buy list on `job_line_part`. Field progress on `scope_phase` + `progress_entry`.
    Operational reports sum `status = active` only; voided rows keep CO deduct provenance.
  '''
}

Table job_line_part {
  id text [pk, default: `gen_random_uuid()::text`]
  job_line_id text [not null]
  part_id text [not null, note: 'FK → manufacturer_part']
  vendor_part_id text [note: 'nullable FK → vendor_part']
  site_area_id text [note: 'nullable FK → site_area — override sold-line place']
  site_asset_id text [note: 'nullable FK → site_asset — device-level override']
  description text [not null, default: '']
  quantity numeric [not null, default: 1]
  unit text [not null, default: 'ea', note: 'snapshotted — often purchase_unit from part']
  unit_cost numeric [not null, default: 0]
  sort_order int [not null, default: 0]

  Note: '''
    Engineering / procurement explosion — exact parts to buy for a sold `job_line`. UOM from
    `manufacturer_part`. Labor-only sold lines typically have no rows here. Requisition via
    `requested_order_line.job_line_part_id`; job BOM shows rollup order status from requisition
    + PO + `job_material_movement` (computed in DAL).
  '''
}

Table scope_phase {
  id text [pk, default: `gen_random_uuid()::text`]
  job_line_id text [not null]
  labor_phase_id text [note: 'nullable FK → labor_phase — bridges item matrix to progress (37n)']
  name text [not null, note: 'Install, Program, Test, Complete, …']
  sequence int [not null]
  planned_qty numeric [not null, default: 0]
  completed_qty numeric [not null, default: 0]
  progress_weight numeric [not null, default: 1]
  billing_weight numeric [not null, default: 1]
  requires_previous_phase boolean [not null, default: false]
  target_date date [note: 'nullable — install target; order_by = target − vendor_part.lead_time_days (P2)']
  sort_order int [not null, default: 0]

  Note: '''
    Per scope item (`job_line`) — fractional completion lives here (replaces `job_work_item`).
    Seeded from resolved `item_labor_phase` filtered by estimate scope/zone inclusion on win (37n).
    `progress_entry_line` quantities roll up into `completed_qty`.
  '''
}

Table progress_entry {
  id text [pk, default: `gen_random_uuid()::text`]
  job_id text [not null]
  work_date date [not null]
  entered_by text [note: 'nullable FK → employee.party_id']
  crew_note text [not null, default: '']
  note text [not null, default: '']
  created_at timestamptz [not null, default: `now()`]

  Note: '''
    Field progress header — work date, crew, notes. No workflow/status v1 (J2) — save applies
    immediately to `scope_phase.completed_qty`. Child collection on `job_detail` Field tab.
  '''
}

Table progress_entry_line {
  id text [pk, default: `gen_random_uuid()::text`]
  progress_entry_id text [not null]
  scope_phase_id text [not null]
  quantity_completed numeric [not null, default: 0]
  site_area_id text [note: 'nullable FK → site_area']
  site_asset_id text [note: 'nullable FK → site_asset']
  sort_order int [not null, default: 0]

  Note: 'One row per scope phase reported in this entry. Sums into `scope_phase.completed_qty`.'
}

Table job_system_spec {
  id text [pk, default: `gen_random_uuid()::text`]
  job_scope_group_id text [not null, note: 'FK → job_scope_group — system block from win']
  system_spec_def_id uuid [not null]
  system_spec_option_id uuid [note: 'nullable — enum defs']
  value_boolean boolean [note: 'nullable — boolean defs']
  value_number numeric [note: 'nullable — number/range (canonical, 37p)']
  value_number_max numeric [note: 'nullable — range part rows only']

  Note: 'Spec snapshot on win — copied from `estimate_condition_spec` per condition tree (37y).'
}

Table job_area_spec {
  id text [pk, default: `gen_random_uuid()::text`]
  job_scope_group_id text [not null]
  site_area_id text [not null]
  system_spec_def_id uuid [not null]
  system_spec_option_id uuid [note: 'nullable — enum defs']
  value_boolean boolean [note: 'nullable — boolean defs']
  value_number numeric [note: 'nullable — number/range (canonical, 37p)']
  value_number_max numeric [note: 'nullable — range part rows only']

  Note: 'Per-area spec snapshot on win — copied from `estimate_zone_spec`.'
}

Table job_line_spec {
  id text [pk, default: `gen_random_uuid()::text`]
  job_line_id text [not null]
  system_spec_def_id uuid [not null]
  system_spec_option_id uuid [note: 'nullable — enum defs']
  value_boolean boolean [note: 'nullable — boolean defs']
  value_number numeric [note: 'nullable — number/range (canonical, 37p)']
  value_number_max numeric [note: 'nullable — range part rows only']

  Note: 'Per-line spec snapshot on win — copied from `estimate_line_spec`.'
}

Table change_order {
  id text [pk, default: `gen_random_uuid()::text`]
  job_id text [not null]
  estimate_id text [note: 'nullable FK → estimate — optional CO source quote']
  title text [not null, default: '']
  status text [not null, default: 'draft', note: 'CHECK: draft | approved | rejected']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    Job scope delta — additive, deductive, or revise. On approve: `add` → new `job_line`;
    `deduct` → void target line; `revise` → void + replacement line. CO lines immutable;
    operational scope stays on `job_line` with `change_order_line_id` provenance.
  '''
}

Table change_order_line {
  id text [pk, default: `gen_random_uuid()::text`]
  change_order_id text [not null]
  line_number int [not null]
  line_action text [not null, default: 'add', note: 'CHECK: add | deduct | revise']
  target_job_line_id text [note: 'nullable FK → job_line — required for deduct | revise']
  description text [not null, default: '']
  quantity numeric [not null, default: 1]
  unit text [not null, default: 'ea']
  unit_price numeric [not null, default: 0]
  sort_order int [not null, default: 0]

  indexes {
    (change_order_id, line_number) [unique, name: 'change_order_line_number_unique']
  }

  Note: 'CO line — snapshot values. Child collection on `change_order_detail`.'
}

// ─── Business (SubHub Slice 6a — procurement) ────────────────────────────────

TableGroup procurement [color: #8e44ad] {
  requested_order
  requested_order_line
  purchase_order
  purchase_order_line
  purchase_order_line_shipment
  material_receipt
  material_receipt_line
  job_material_movement
}

Table requested_order {
  id text [pk, default: `gen_random_uuid()::text`]
  job_id text [not null]
  phase_id text [note: 'nullable FK → phase — batch tag for this pull (e.g. prewire)']
  requested_by text [note: 'nullable FK → employee.party_id — PM, site tech, …']
  requested_at timestamptz [not null, default: `now()`]
  note text [not null, default: '']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    Requisition header — PM or site tech asks for parts on a job (engineered BOM or ad-hoc).
    Each line must eventually be **ordered** (added to a `purchase_order`) or **withdrawn**
    (won't buy — scope change, using other supply, etc.). See `requested_order_line` lifecycle.
    Child collection `lines` on job detail or `requested_order_detail`.
  '''
}

Table requested_order_line {
  id text [pk, default: `gen_random_uuid()::text`]
  requested_order_id text [not null]
  line_number int [not null]
  job_line_part_id text [note: 'nullable FK → job_line_part — engineered BOM row']
  part_id text [note: 'nullable FK → manufacturer_part — ad-hoc or snapshot PN']
  description text [not null, default: '']
  quantity numeric [not null, default: 1]
  unit text [not null, default: 'ea']
  site_area_id text [note: 'nullable FK → site_area — where parts are needed']
  site_asset_id text [note: 'nullable FK → site_asset — device-level need']
  status text [not null, default: 'open', note: 'CHECK: open | on_purchase_order | fulfilled | withdrawn']
  withdrawal_note text [not null, default: '', note: 'required context when status = withdrawn']
  sort_order int [not null, default: 0]

  indexes {
    (requested_order_id, line_number) [unique, name: 'requested_order_line_number_unique']
  }

  Note: '''
    Requisition line lifecycle (every open line ends in one of two outcomes):

    1. **Ordered** — qty added to a `purchase_order_line` (`on_purchase_order` while PO open;
       `fulfilled` when received qty covers the request via `purchase_order_line_shipment` +
       `material_receipt`). Partial: line stays `open` until fully covered.

    2. **Withdrawn** — PM explicitly won't order (`withdrawn` + `withdrawal_note`). No
       `purchase_order` required. If parts still arrive (shop stock, customer drop-off), log a
       **`material_receipt`** separately — that is physical arrival, not the requisition.

    **Engineered:** `job_line_part_id` set. **Ad-hoc:** null `job_line_part_id`, `part_id` and/or
    `description`. Job BOM Order column = DAL rollup across requisition + purchase order + receipt.
  '''
}

Table purchase_order {
  id text [pk, default: `gen_random_uuid()::text`]
  job_id text [not null]
  vendor_party_id text [not null, note: 'FK → party (vendor tag)']
  po_number text [note: 'nullable until issued — unique when set']
  status text [not null, default: 'draft', note: 'CHECK: draft | sent | received | cancelled']
  delivery_method text [note: 'nullable — v1 text or future catalog: will_call | site_drop | office | …']
  ship_to_note text [not null, default: '', note: 'nullable ship-to / delivery instructions']
  order_date date [note: 'nullable']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    po_number [unique, name: 'purchase_order_po_number_unique', note: 'partial: WHERE po_number IS NOT NULL']
  }

  Note: '''
    Vendor commitment from job. Created draft from Requested pool (grouped by vendor) or manually.
    Must stay **draft** to add ad-hoc lines; **Send** issues PO (`sent`). Header `received` when all
    lines received or cancelled.
  '''
}

Table purchase_order_line {
  id text [pk, default: `gen_random_uuid()::text`]
  purchase_order_id text [not null]
  line_number int [not null]
  description text [not null, default: '']
  quantity numeric [not null, default: 1]
  unit text [not null, default: 'ea']
  unit_price numeric [not null, default: 0]
  part_id text [note: 'nullable FK → manufacturer_part']
  vendor_part_id text [note: 'nullable FK → vendor_part']
  job_line_id text [note: 'nullable FK → job_line']
  job_line_part_id text [note: 'nullable FK → job_line_part']
  requested_order_line_id text [note: 'nullable FK → requested_order_line — null for ad-hoc purchase order lines']
  status text [not null, default: 'draft', note: 'CHECK: draft | ordered | acknowledged | partial | received | cancelled | rejected — rollup from shipments when split']
  ordered_at timestamptz [note: 'nullable — set when purchase order sent']
  rejection_note text [not null, default: '']
  sort_order int [not null, default: 0]

  indexes {
    (purchase_order_id, line_number) [unique, name: 'purchase_order_line_number_unique']
  }

  Note: '''
    Purchase order line — snapshot **total** qty/price (e.g. 10× ABC-123). Schedule and receipt
    dates live on **`purchase_order_line_shipment`** child rows (5 ETA Jul 3, 5 ETA Aug 10).
    Single delivery = one shipment row with full qty. Line `status` rolls up from shipments
    (`partial` when some received). Links requisition (`requested_order_line_id`) and/or BOM
    (`job_line_part_id`).
  '''
}

Table purchase_order_line_shipment {
  id text [pk, default: `gen_random_uuid()::text`]
  purchase_order_line_id text [not null]
  shipment_number int [not null, note: '1-based within parent purchase_order_line']
  quantity numeric [not null, default: 1, note: 'portion of purchase_order_line.quantity — sum ≤ parent qty']
  eta_date date [note: 'nullable — expected arrival for this portion']
  delivered_at timestamptz [note: 'nullable — carrier / site delivery timestamp']
  received_at timestamptz [note: 'nullable — logged receive at job (may match material_receipt)']
  status text [not null, default: 'scheduled', note: 'CHECK: scheduled | shipped | delivered | received | cancelled']
  sort_order int [not null, default: 0]

  indexes {
    (purchase_order_line_id, shipment_number) [unique, name: 'purchase_order_line_shipment_number_unique']
  }

  Note: '''
    Split schedule for one purchase order line — child collection on `purchase_order_detail`
    (nested under line or flat with line ref). Example: line qty 10 → shipment 1 qty 5 eta Jul 3,
    shipment 2 qty 5 eta Aug 10. Job BOM ETA rollup = earliest open shipment eta per
    `job_line_part_id`. Receipt links via `material_receipt_line.purchase_order_line_shipment_id`.
  '''
}

Table material_receipt {
  id text [pk, default: `gen_random_uuid()::text`]
  job_id text [not null]
  received_at timestamptz [not null, default: `now()`]
  received_by text [note: 'nullable FK → employee.party_id']
  source_kind text [not null, default: 'purchase_order', note: 'CHECK: purchase_order | stock | customer_supplied | other']
  note text [not null, default: '']
  created_at timestamptz [not null, default: `now()`]

  Note: '''
    **Material receipt** — the record that parts **physically arrived at the job site** (truck
    delivery, will-call pickup logged on site, stock brought from shop, customer drop-off).
    This is separate from the requisition ("we need parts") and `purchase_order` ("we bought
    from vendor"). A receipt line posts a `job_material_movement` (`receive`) so on-hand qty
    updates. When tied to a vendor order, link `purchase_order_line_shipment_id`.
  '''
}

Table material_receipt_line {
  id text [pk, default: `gen_random_uuid()::text`]
  material_receipt_id text [not null]
  line_number int [not null]
  purchase_order_line_id text [note: 'nullable FK → purchase_order_line — when source_kind = purchase_order']
  purchase_order_line_shipment_id text [note: 'nullable FK → purchase_order_line_shipment — which scheduled portion arrived']
  part_id text [not null, note: 'FK → manufacturer_part']
  job_line_part_id text [note: 'nullable FK → job_line_part']
  quantity numeric [not null, default: 1]
  sort_order int [not null, default: 0]

  indexes {
    (material_receipt_id, line_number) [unique, name: 'material_receipt_line_number_unique']
  }

  Note: 'Receipt line — child collection on `material_receipt_detail`. Prefer `purchase_order_line_shipment_id` when receiving a split portion; DAL writes matching `receive` movement.'
}

Table job_material_movement {
  id text [pk, default: `gen_random_uuid()::text`]
  job_id text [not null]
  part_id text [not null, note: 'FK → manufacturer_part']
  movement_kind text [not null, note: 'CHECK: receive | issue | adjust | return_vendor']
  quantity numeric [not null, default: 1, note: 'always positive; kind determines sign in balance rollup']
  purchase_order_line_id text [note: 'nullable FK → purchase_order_line']
  purchase_order_line_shipment_id text [note: 'nullable FK → purchase_order_line_shipment — receive against scheduled portion']
  material_receipt_line_id text [note: 'nullable FK → material_receipt_line']
  job_line_part_id text [note: 'nullable FK → job_line_part — demand row this supports']
  scope_phase_id text [note: 'nullable FK → scope_phase — when issued to installed work']
  note text [not null, default: '']
  recorded_at timestamptz [not null, default: `now()`]
  recorded_by text [note: 'nullable FK → employee.party_id']

  indexes {
    (job_id, part_id, recorded_at) [name: 'job_material_movement_job_part_idx']
  }

  Note: '''
    Job-site inventory **ledger** (v1 minimal — not org-wide warehouse). **On hand** per
    job × part = SUM(receive + adjust) − SUM(issue + return_vendor) — computed in DAL for
    job BOM / stock panel. **Surplus** = on hand minus qty still needed for open scope.
    v2 may add org warehouse; v1 is job-scoped only.
  '''
}

// ─── Business (SubHub Slice 6b — billing) ────────────────────────────────────

TableGroup billing [color: #9b59b6] {
  billable_line
  invoice
  invoice_line
  schedule_of_value
  sov_line
  sov_allocation
}

Table billable_line {
  id text [pk, default: `gen_random_uuid()::text`]
  job_id text [not null]
  source_kind text [not null, default: 'manual', note: 'CHECK: job_line | scope_phase | receipt_line | sov_line | manual']
  billing_basis text [not null, default: 'manual', note: 'CHECK: qty_installed | qty_received | sov_scheduled | manual']
  job_line_id text [note: 'nullable FK → job_line — scope traceability; set when mappable']
  scope_phase_id text [note: 'nullable FK → scope_phase — when source_kind = scope_phase']
  material_receipt_line_id text [note: 'nullable FK → material_receipt_line — when billing on receipt']
  sov_line_id text [note: 'nullable FK → sov_line — when billing SOV milestone']
  description text [not null, default: '']
  quantity numeric [not null, default: 1, note: 'billable qty — cap enforced vs job_line in DAL']
  unit text [not null, default: 'ea']
  unit_price numeric [not null, default: 0, note: 'suggested from job_line at creation; editable before invoice']
  status text [not null, default: 'open', note: 'CHECK: open | on_invoice | void']
  invoice_line_id text [note: 'nullable FK → invoice_line — denormalized cache; canonical link is invoice_line.billable_line_id']
  as_of_date date [note: 'nullable — earned-through date for progress billing']
  note text [not null, default: '']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (job_id, status) [name: 'billable_line_job_status_idx']
  }

  Note: '''
    **Earned / billable staging** — parallel to requisition before PO. What *may* be invoiced,
    not yet a customer document. DAL may auto-generate from `scope_phase` rollups (install),
    from `material_receipt_line` (received qty), or from SOV remaining balance — **deferred v1**
    (B4: manual staging first). **Invoice pickup:** DAL inserts `invoice_line` with `billable_line_id`
    then sets `billable_line.invoice_line_id` + status `on_invoice` in the same transaction. Void
    invoice → revert linked rows to `open`. Child collection `billable_items` on `job_detail`
    billing section (Slice 6b).
  '''
}

Table invoice {
  id text [pk, default: `gen_random_uuid()::text`]
  job_id text [not null]
  invoice_number text [note: 'nullable until issued — unique when set']
  billing_kind text [not null, default: 'standard', note: 'CHECK: standard | deposit | progress | retention_release | final']
  status text [not null, default: 'draft', note: 'CHECK: draft | sent | paid | void']
  invoice_date date [note: 'nullable']
  due_date date [note: 'nullable']
  period_start date [note: 'nullable — progress billing window start']
  period_end date [note: 'nullable — progress billing window end (e.g. monthly)']
  gross_subtotal numeric [not null, default: 0, note: 'snapshot at issue — sum of line extensions before adjustments']
  retainage_withheld numeric [not null, default: 0, note: 'snapshot at issue — withheld per job.retainage_pct']
  deposit_applied numeric [not null, default: 0, note: 'snapshot at issue — deposit credit applied on this invoice']
  net_due numeric [not null, default: 0, note: 'snapshot at issue — amount customer owes on this invoice']
  issued_at timestamptz [note: 'nullable — when status moved draft → sent']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    invoice_number [unique, name: 'invoice_invoice_number_unique', note: 'partial: WHERE invoice_number IS NOT NULL']
  }

  Note: '''
    Customer billing document from job. Lines snapshot amounts on `invoice_line`. Progress /
    deposit / retention_release / final kinds support monthly billing with retainage. Payment
    ledger deferred — v1 uses `status = paid` on `net_due`. Issue action freezes header totals.
  '''
}

Table invoice_line {
  id text [pk, default: `gen_random_uuid()::text`]
  invoice_id text [not null]
  line_number int [not null]
  description text [not null, default: '']
  quantity numeric [not null, default: 1]
  unit text [not null, default: 'ea']
  unit_price numeric [not null, default: 0]
  job_line_id text [note: 'nullable FK → job_line — billed against scope line']
  billable_line_id text [note: 'nullable FK → billable_line — canonical pickup link when staged from billable_line']
  sov_line_id text [note: 'nullable FK → sov_line — when line bills a SOV milestone directly']
  sort_order int [not null, default: 0]

  indexes {
    (invoice_id, line_number) [unique, name: 'invoice_line_number_unique']
  }

  Note: 'Invoice line — snapshot. `billable_line_id` is the canonical FK to staging; `billable_line.invoice_line_id` is denormalized cache. Child collection `line_items` on `invoice_detail`.'
}

Table schedule_of_value {
  id text [pk, default: `gen_random_uuid()::text`]
  job_id text [not null]
  name text [not null, default: '']
  retainage_pct numeric [note: 'nullable — overrides job.retainage_pct for this SOV when set']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    Progress billing schedule on a job (`billing_model = progress_sov`). One job may have one SOV
    in v1. Milestones on `sov_line`; sold scope mapped via `sov_allocation`. DAL warns when
    SUM(sov_line.scheduled_value) diverges from active job_line extended price.
  '''
}

Table sov_line {
  id text [pk, default: `gen_random_uuid()::text`]
  schedule_of_value_id text [not null]
  line_number int [not null]
  line_kind text [not null, default: 'base', note: 'CHECK: base | change_order | deposit | retention']
  description text [not null, default: '']
  scheduled_value numeric [not null, default: 0, note: 'contract amount for milestone']
  sort_order int [not null, default: 0]

  indexes {
    (schedule_of_value_id, line_number) [unique, name: 'sov_line_number_unique']
  }

  Note: '''
    SOV milestone line. `deposit` and `retention` kinds for initial deposit and retainage pool
    rows. Progress billing caps earned amount per line via allocations + prior invoiced totals.
    Child collection `sov_milestones` on `job_detail` Billing tab only — no standalone SOV Surface
    ([SOV UI decision](../docs/decisions/billing.md#decision-sov-ui--nested-on-job_detail-billing-tab-2026-06-17)).
  '''
}

Table sov_allocation {
  id text [pk, default: `gen_random_uuid()::text`]
  sov_line_id text [not null]
  job_scope_group_id text [note: 'nullable FK → job_scope_group — primary v1 milestone target']
  job_line_id text [note: 'nullable FK → job_line']
  scope_phase_id text [note: 'nullable FK → scope_phase — phase-weighted earn']
  phase_id text [note: 'nullable FK → phase — org catalog bridge; retire for new jobs']
  allocation_pct numeric [note: 'nullable — XOR with allocated_value; percent of job_line extended price']
  allocated_value numeric [note: 'nullable — XOR with allocation_pct; fixed $ slice on this SOV line']
  sort_order int [not null, default: 0]

  Note: '''
    Maps sold scope, scope groups, and/or phases to SOV milestones (many-to-many). Manual on job
    setup in v1. **Exactly one** of `allocation_pct` or `allocated_value` must be set per row
    (CHECK in migration). DAL rolls up earned qty from linked `scope_phase` / `job_line` to cap
    billable amount per `sov_line.scheduled_value`.
  '''
}

// ─── Relationships ────────────────────────────────────────────────────────────

Ref: latch_user_roles.user_id > latch_users.id [delete: cascade]
Ref: latch_user_roles.role_id > latch_roles.id [delete: restrict]
Ref: latch_user_roles.scope_id > latch_scopes.id

Ref: latch_role_surfaces.role_id > latch_roles.id [delete: cascade]
Ref: latch_role_grants.role_id > latch_roles.id [delete: cascade]
Ref: latch_role_delegations.role_id > latch_roles.id [delete: cascade]
Ref: latch_role_delegations.assignable_role_id > latch_roles.id [delete: cascade]
Ref: latch_scopes.parent_id > latch_scopes.id

Ref: latch_pending_changes.supersedes_id > latch_pending_changes.id

Ref: party_person.party_id > party.id [delete: cascade]
Ref: party_organization.party_id > party.id [delete: cascade]
Ref: party_organization.parent_party_id > party.id [delete: set null]
Ref: party_role.party_id > party.id [delete: cascade]
Ref: party_phone.party_id > party.id [delete: cascade]
Ref: party_email.party_id > party.id [delete: cascade]
Ref: party_contact.organization_party_id > party.id [delete: cascade]
Ref: party_contact.contact_party_id > party.id [delete: cascade]
Ref: party_contact.relation_id > party_contact_relation.id [delete: restrict]
Ref: party_address.party_id > party.id [delete: cascade]
Ref: party_person.latch_user_id > latch_users.id [delete: set null]
Ref: employee.party_id > party_person.party_id [delete: cascade]

Ref: party_address.address_id > address.id [delete: cascade]
Ref: site.physical_address_id > address.id [delete: set null]
Ref: site.customer_party_id > party.id [delete: set null]
Ref: site.parent_site_id > site.id [delete: set null]
Ref: site_scope.site_id > site.id [delete: cascade]
Ref: site_scope.root_item_id > item.id [delete: restrict]
Ref: site_zone.site_id > site.id [delete: cascade]
Ref: site_zone.site_scope_id > site_scope.id [delete: set null]
Ref: site_zone.parent_zone_id > site_zone.id [delete: set null]
Ref: site_asset.site_id > site.id [delete: cascade]
Ref: site_asset.site_scope_id > site_scope.id [delete: set null]
Ref: site_asset.site_zone_id > site_zone.id [delete: set null]
Ref: site_asset.part_id > manufacturer_part.id [delete: set null]
Ref: site_asset.replaced_by_site_asset_id > site_asset.id [delete: set null]
Ref: site_asset.installed_by_job_id > job.id [delete: set null]
Ref: site_contact.site_id > site.id [delete: cascade]
Ref: site_contact.party_id > party.id [delete: cascade]
Ref: site_contact.relation_id > site_contact_relation.id [delete: restrict]

Ref: item.parent_id > item.id [delete: set null]
Ref: item.freight_rate_type_id > cost_add_on_type.id [delete: set null]
Ref: item.incidental_rate_type_id > cost_add_on_type.id [delete: set null]
Ref: item.markup_type_id > markup_type.id [delete: set null]
