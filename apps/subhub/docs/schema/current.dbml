Ref: employee.party_id > party_person.party_id [delete: cascade]
Ref: employee.latch_user_id > latch_users.id [delete: set null]

Ref: party_location.location_id > location.id [delete: cascade]
Ref: site.parent_site_id > site.id [delete: set null]
Ref: site_contact.site_id > site.id [delete: cascade]
Ref: site_contact.party_id > party.id [delete: cascade]
Ref: site_contact.relation_id > site_contact_relation.id [delete: restrict]

Ref: manufacturer_part.manufacturer_party_id > party.id [delete: restrict]
Ref: vendor_part_price.vendor_party_id > party.id [delete: cascade]
Ref: vendor_part_price.part_id > manufacturer_part.id [delete: cascade]
Ref: item.category_id > item_category.id [delete: set null]
Ref: item_category.parent_id > item_category.id [delete: set null]
Ref: item_part_link.item_id > item.id [delete: cascade]
Ref: item_part_link.part_id > manufacturer_part.id [delete: restrict]

Ref: estimate.site_id > site.id [delete: restrict]
Ref: estimate.source_estimate_id > estimate.id [delete: set null]
Ref: estimate_party.estimate_id > estimate.id [delete: cascade]
Ref: estimate_party.party_id > party.id [delete: cascade]
Ref: estimate_party.relation_id > job_party_relation.id [delete: restrict]
Ref: estimate_line.estimate_id > estimate.id [delete: cascade]
Ref: estimate_line.location_id > location.id [delete: set null]
Ref: estimate_line.item_id > item.id [delete: set null]
Ref: estimate_line.part_id > manufacturer_part.id [delete: set null]

Ref: job.site_id > site.id [delete: restrict]
Ref: job.estimate_id > estimate.id [delete: set null]
Ref: job_party.job_id > job.id [delete: cascade]
Ref: job_party.party_id > party.id [delete: cascade]
Ref: job_party.relation_id > job_party_relation.id [delete: restrict]
Ref: job_location.job_id > job.id [delete: cascade]
Ref: job_location.location_id > location.id [delete: cascade]
Ref: job_line.job_id > job.id [delete: cascade]
Ref: job_line.location_id > location.id [delete: set null]
Ref: job_line.item_id > item.id [delete: set null]
Ref: job_line.part_id > manufacturer_part.id [delete: set null]
Ref: job_line.estimate_line_id > estimate_line.id [delete: set null]
Ref: job_line_progress.job_line_id > job_line.id [delete: cascade]
Ref: change_order.job_id > job.id [delete: cascade]
Ref: change_order_line.change_order_id > change_order.id [delete: cascade]

Ref: invoice.job_id > job.id [delete: restrict]
Ref: invoice_line.invoice_id > invoice.id [delete: cascade]
Ref: invoice_line.job_line_id > job_line.id [delete: set null]
Ref: purchase_order.job_id > job.id [delete: restrict]
Ref: purchase_order.vendor_party_id > party.id [delete: restrict]
Ref: po_line.purchase_order_id > purchase_order.id [delete: cascade]
Ref: po_line.part_id > manufacturer_part.id [delete: set null]
Ref: po_line.job_line_id > job_line.id [delete: set null]
Ref: schedule_of_value.job_id > job.id [delete: cascade]
Ref: sov_line.schedule_of_value_id > schedule_of_value.id [delete: cascade]
