{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@latch/contracts": ["../../packages/contracts/src/index.ts"],
      "@latch/policy": ["../../packages/policy/src/index.ts"],
      "@latch/dal": ["../../packages/dal/src/index.ts"],
      "@latch/audit": ["../../packages/audit/src/index.ts"],
      "@latch/approval": ["../../packages/approval/src/index.ts"],
      "@latch/react": ["../../packages/react/src/index.ts"],
      "@latch/codegen": ["../../packages/codegen/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"],
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/policy" },
    { "path": "../../packages/dal" },
    { "path": "../../packages/audit" },
    { "path": "../../packages/approval" },
    { "path": "../../packages/react" },
    { "path": "../../packages/codegen" }
  ]
}
