# Auth.js — required in all environments (generate: npx auth secret)
AUTH_SECRET=replace-with-openssl-rand-hex-32

# Dev Credentials provider (local + preview only; never in production)
CRM_DEV_PASSWORD=demo
# CRM_ENABLE_DEV_CREDENTIALS=true  # optional: allow Credentials when NODE_ENV=production (preview)

# OAuth (preview/production) — enable when IdP is configured
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Optional — Postgres for latch_audit writes and future Postgres DAL
# Local Docker: npm run db:docker:up, apply migrations 001–005, then:
# DATABASE_URL=postgresql://latch:latch@localhost:5432/latch
#
# Production / preview app runtime: use the app role (INSERT-only on latch_audit), not the DB owner:
# DATABASE_URL=postgresql://latch_app:SECRET@host/db?sslmode=require
#
# Neon owner URL (migrations only): keep a separate superuser/owner connection locally; never ship it to Vercel.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#
# Threat test T6 (optional local): connection as latch_app after 005_latch_app_role.sql
# LATCH_APP_DATABASE_URL=postgresql://latch_app:latch_app@localhost:5432/latch
