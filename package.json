{
  "name": "latch-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @latch/subhub",
    "build": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint .",
    "check:imports": "node scripts/check-extensionless-imports.mjs",
    "db:docker:up": "docker compose up -d",
    "db:docker:down": "docker compose down",
    "db:docker:logs": "docker compose logs -f postgres",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:check": "node scripts/db-migrate.mjs --check",
    "test": "vitest run",
    "codegen": "npm -w @latch/codegen run generate",
    "codegen:check": "npm -w @latch/codegen run check",
    "latch:new": "npm -w @latch/codegen run new --"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "next": "16.2.6",
    "react-dom": "19.2.4",
    "typescript": "^5",
    "tsx": "^4.19.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
