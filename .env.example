# Copy to apps/web/.env.local for Next.js (not committed)
# cp apps/web/.env.example apps/web/.env.local

# Dev server — Latch defaults to 3001 (see apps/web/package.json) to avoid clashing with other apps on 3000
# PORT=3001

# PostgreSQL — Neon (local dev, preview, prod)
# Dashboard → Connect → Direct connection (for migrate + psql)
# Vercel: use Pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: only if using docker-compose.yml (not required)
# DATABASE_URL=postgresql://latch:latch@localhost:5432/latch
# POSTGRES_USER=latch
# POSTGRES_PASSWORD=latch
# POSTGRES_DB=latch
# POSTGRES_PORT=5432
