# Copy to .env.local for Next.js (not committed)
# cp .env.example .env.local

# Dev server — Latch defaults to 3001 (see apps/web/package.json) to avoid clashing with other apps on 3000
# PORT=3001

# PostgreSQL — local Docker (default for dev)
DATABASE_URL=postgresql://latch:latch@localhost:5432/latch

# Vercel preview/production (required there): Neon or other hosted Postgres
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/latch?sslmode=require
POSTGRES_USER=latch
POSTGRES_PASSWORD=latch
POSTGRES_DB=latch
POSTGRES_PORT=5432
